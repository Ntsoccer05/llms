# ========== アプリ設定（app/config.py） ==========
# Notion（必須）
NOTION_API_KEY=
NOTION_API_URL=https://api.notion.com/v1
NOTION_DATABASE_ID=
NOTION_DATASOURCE_ID=

# LLM / AWS（必須）
MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# GitHub（オプション）
GITHUB_TOKEN=
GITHUB_REPO=

# リポジトリ・バックエンド（オプション）
REPO_PATH=
BACKEND_URL=http://localhost:8000
BACKEND_HOST=
BACKEND_PORT=8000

# 通知（オプション。Streamlit + watcher 用）
# NOTIFY_DIR を空で書くと Docker で通知が出ません。Docker 時は /notify を指定するか、この行を削除して compose のデフォルトに任せる。
# NOTIFY_DIR=/notify
NOTIFY_BACKEND_URL=http://localhost:8000

# ========== Docker Compose 用 ==========
APP_ENV=development
APP_HOST_PORT=8000
STREAMLIT_HOST_PORT=8501
STREAMLIT_PORT=8501
STREAMLIT_ADDRESS=0.0.0.0
